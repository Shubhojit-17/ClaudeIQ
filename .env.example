# ============================================================
# ClauseIQ — Environment Variables Template
# Copy this to .env and fill in your values
# ============================================================

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=clauseiq
POSTGRES_PASSWORD=clauseiq_secret
POSTGRES_DB=clauseiq_db
DATABASE_URL=postgresql://clauseiq:clauseiq_secret@localhost:5432/clauseiq_db

# ─── Backend (FastAPI) ──────────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── AI / LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o

# ─── Cloud Storage (S3) ────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=clauseiq-contracts

# ─── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
