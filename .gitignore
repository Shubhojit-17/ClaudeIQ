# ============================================================
# ClauseIQ — .gitignore
# Python + Node.js + Docker + IDE + OS
# ============================================================

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.Python
*.db
*.sqlite3

# ─── Node.js ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ─── Build Output ───────────────────────────────────────────
frontend/dist/
frontend/build/
*.tsbuildinfo

# ─── Environment Variables ──────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Docker ─────────────────────────────────────────────────
docker-compose.override.yml
pgdata/

# ─── IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Testing & Coverage ────────────────────────────────────
htmlcov/
.coverage
.coverage.*
.pytest_cache/
coverage/
*.lcov

# ─── Misc ───────────────────────────────────────────────────
*.log
*.tmp
*.bak
